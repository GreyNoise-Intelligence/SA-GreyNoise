{
    "openapi": "3.0.0",
    "info": {
        "title": "SA-GreyNoise",
        "version": "3.0.2",
        "description": "GreyNoise App for Splunk",
        "contact": {
            "name": "GreyNoise",
            "email": "support@greynoise.io"
        }
    },
    "servers": [
        {
            "url": "https://{domain}:{port}/servicesNS/-/SA-GreyNoise",
            "variables": {
                "domain": {
                    "default": "localhost"
                },
                "port": {
                    "default": "8089"
                }
            },
            "description": "Access via management interface"
        }
    ],
    "components": {
        "schemas": {
            "parameters": {
                "type": "object",
                "properties": {
                    "api_key": {
                        "type": "string",
                        "format": "password"
                    }
                }
            },
            "parameters_without_name": {
                "type": "object",
                "properties": {
                    "api_key": {
                        "type": "string",
                        "format": "password"
                    }
                }
            },
            "scan_deployment": {
                "type": "object",
