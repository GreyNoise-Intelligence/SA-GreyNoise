<form isDashboard="true" version="1.1" theme="dark">
  <label>Overview</label>
  <fieldset submitButton="false" autoRun="true"></fieldset>
  <row>
    <panel>
      <html>
        <center>
          <h1>The tiles below represent data about the Scan Deployment and Feed functions of this app and deployment.</h1>
        </center>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <single>
        <title># of IPs scanned in the deployment</title>
        <search>
          <query>| inputlookup gn_scan_deployment_ip_lookup
| stats count</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">all</option>
        <option name="refresh.display">preview</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[
              /app/SA-GreyNoise/queried_ip_addresses?form.tkn_ip_address=*
            ]]>
          </link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <single>
        <title># of indicators in GreyNoise Feed lookup</title>
        <search>
          <query>| inputlookup greynoise_indicators
| stats count</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">all</option>
        <option name="rangeColors">["0x53a051","0x0877a6","0xf8be34","0xf1813f","0xdc4e41"]</option>
        <option name="refresh.display">preview</option>
      </single>
    </panel>
    <panel>
      <table>
        <title># Indicators by Classification in Feed Lookup</title>
        <search>
          <query>| inputlookup greynoise_indicators
| stats count by classification
| sort -count</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">preview</option>
        <format type="color" field="classification">
          <colorPalette type="map">{"benign":#118832,"malicious":#D41F1F,"suspicious":#CBA700}</colorPalette>
        </format>
        <format type="number" field="count">
          <option name="precision">0</option>
        </format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <single>
        <title># of Internet Scanner IPs in the deployment</title>
        <search>
          <query>| inputlookup gn_scan_deployment_ip_lookup where (internet_scanner_intelligence="1")
| stats count</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">all</option>
        <option name="refresh.display">preview</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[
              /app/SA-GreyNoise/queried_ip_addresses?form.tkn_ip_address=*&form.tkn_scanner=1
            ]]>
          </link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <single>
        <title>Percentage of Internet Scanner IPs in the deployment</title>
        <search>
          <query>| inputlookup gn_scan_deployment_ip_lookup
| stats count(eval(internet_scanner_intelligence=1)) AS noisy_ips, count(eval(internet_scanner_intelligence=1 OR internet_scanner_intelligence=0)) AS total_ips
| eval internet_scanner_percent=((noisy_ips/total_ips)*100)
| eval internet_scanner_percent = if(internet_scanner_percent&gt;0, internet_scanner_percent, 0)
| table internet_scanner_percent</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0.00</option>
        <option name="refresh.display">preview</option>
        <option name="unit">%</option>
      </single>
    </panel>
    <panel>
      <table>
        <title># of Internet Scanner IPs by Classification</title>
        <search>
          <query>| inputlookup gn_scan_deployment_ip_lookup where (internet_scanner_intelligence="1")
| stats count by classification
| sort -count</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">preview</option>
        <format type="color" field="classification">
          <colorPalette type="map">{"benign":#118832,"malicious":#D41F1F,"suspicious":#CBA700}</colorPalette>
        </format>
        <format type="number" field="count">
          <option name="precision">0</option>
        </format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <single>
        <title># of Business Service IPs in the deployment</title>
        <search>
          <query>| inputlookup gn_scan_deployment_ip_lookup where (business_service_intelligence="1")
| stats count</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">all</option>
        <option name="refresh.display">preview</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[
              /app/SA-GreyNoise/queried_ip_addresses?form.tkn_ip_address=*&form.tkn_bizserv=1
            ]]>
          </link>
        </drilldown>
      </single>
    </panel>
    <panel>
      <single>
        <title>Percentage of Business Service IPs in the deployment</title>
        <search>
          <query>| inputlookup gn_scan_deployment_ip_lookup
| stats count(eval(business_service_intelligence=1)) AS business_service_ips, count(eval(business_service_intelligence=1 OR business_service_intelligence=0)) AS total_ips
| eval business_service_percent=((business_service_ips/total_ips)*100)
| eval business_service_percent = if(business_service_percent&gt;0, business_service_percent, 0)
| table business_service_percent</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">none</option>
        <option name="numberPrecision">0.00</option>
        <option name="refresh.display">preview</option>
        <option name="unit">%</option>
      </single>
    </panel>
    <panel>
      <table>
        <title># of Business Service IPs by Trust Level</title>
        <search>
          <query>| inputlookup gn_scan_deployment_ip_lookup where (business_service_intelligence="1")
| eval trust_level_string = tostring(trust_level)
| rename trust_level_string as "Trust Level"
| stats count by "Trust Level"
| sort -count</query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">preview</option>
        <format type="color" field="trust_level">
          <colorPalette type="map">{"1":#55C169,"2":#CBA700}</colorPalette>
        </format>
        <format type="number" field="count">
          <option name="precision">0</option>
        </format>
        <format type="color" field="Trust Level">
          <colorPalette type="map">{"1":#0099E0,"2":#65778A}</colorPalette>
        </format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <html>
        <center>
          <h1>The information below represents the state of the GreyNoise service today.</h1>
        </center>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <single>
        <title># of Malicious IP Addresses in GreyNoise today</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (stats_field=classification AND classification=malicious)
            | table stats_count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="colorMode">none</option>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x555","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="refresh.display">progressbar</option>
        <option name="unitPosition">after</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title># of Suspicious IP Addresses in GreyNoise today</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (stats_field=classification AND classification=suspicious)
            | table stats_count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="colorMode">none</option>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x555","0xcba700"]</option>
        <option name="rangeValues">[0]</option>
        <option name="refresh.display">progressbar</option>
        <option name="unitPosition">after</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title># of Benign IP Addresses in GreyNoise today</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (stats_field=classification AND classification=benign)
            | table stats_count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">none</option>
        <option name="rangeColors">["0x555","0x118832"]</option>
        <option name="rangeValues">[0]</option>
        <option name="refresh.display">progressbar</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title># of Unknown IP Addresses in GreyNoise today</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (stats_field=classification AND classification=unknown)
            | table stats_count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <input type="dropdown" token="tkn_classification" searchWhenChanged="true">
        <label>Classification</label>
        <choice value="*">All</choice>
        <choice value="malicious">malicious</choice>
        <choice value="suspicious">suspicious</choice>
        <choice value="benign">benign</choice>
        <choice value="unknown">unknown</choice>
        <default>*</default>
      </input>
      <html>
        <p>
          <i>
            <b>Note:</b> The data in the panels below are updated every 6 hours. For the most recent information, visit the Trends page of the GreyNoise Visualizer.</i>
        </p>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Top 10 Organizations</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (classification="$tkn_classification$" AND stats_field="organization")
            | stats sum(stats_count) as stats_count by stats_value
            | sort -stats_count
            | head 10
            | rename stats_value as Organization, stats_count as count
            | table Organization, count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">all</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[
              /app/SA-GreyNoise/live_investigation?form.tkn_classification=$tkn_classification$&form.tkn_organization=$click.value$&form.redirect=redirect
            ]]>
          </link>
        </drilldown>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Top 10 Actors</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (classification="$tkn_classification$" AND stats_field="actor")
            | stats sum(stats_count) as stats_count by stats_value
            | sort -stats_count
            | head 10
            | rename stats_value as Actor, stats_count as count
            | table Actor, count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.drilldown">all</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[
              /app/SA-GreyNoise/live_investigation?form.tkn_classification=$tkn_classification$&form.tkn_actor=$click.value$&form.redirect=redirect
            ]]>
          </link>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Top 10 Tags</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (classification="$tkn_classification$" AND stats_field="tag")
            | stats sum(stats_count) as stats_count by stats_value
            | sort -stats_count
            | head 10
            | rename stats_value as Tag, stats_count as Count
            | table Tag, Count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.axisY.scale">log</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0x669966]</option>
        <option name="charting.drilldown">all</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[
              /app/SA-GreyNoise/live_investigation?form.tkn_classification=$tkn_classification$&form.tkn_tag=$click.value$&form.redirect=redirect
            ]]>
          </link>
        </drilldown>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Top 10 ASN</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (classification="$tkn_classification$" AND stats_field="asn")
            | stats sum(stats_count) as stats_count by stats_value
            | sort -stats_count
            | head 10
            | rename stats_value as ASN, stats_count as Count
            | table ASN, Count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.axisY.scale">log</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0x6B1037]</option>
        <option name="charting.drilldown">all</option>
        <option name="refresh.display">progressbar</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[
              /app/SA-GreyNoise/live_investigation?form.tkn_classification=$tkn_classification$&form.tkn_asn=$click.value$&form.redirect=redirect
            ]]>
          </link>
        </drilldown>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Top 10 Categories</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (classification="$tkn_classification$" AND stats_field="category")
            | stats sum(stats_count) as stats_count by stats_value
            | sort -stats_count
            | head 10
            | rename stats_value as Category, stats_count as Count
            | table Category, Count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.axisY.scale">log</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0x067097]</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Top 10 OS</title>
        <search>
          <query>
            | inputlookup gn_overview_lookup where (classification="$tkn_classification$" AND stats_field="operating_system")
            | stats sum(stats_count) as stats_count by stats_value
            | sort -stats_count
            | head 10
            | rename stats_value as "Operating System", stats_count as Count
            | table "Operating System", Count
          </query>
          <earliest>0</earliest>
          <latest></latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.axisY.scale">log</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.seriesColors">[0x986B1C]</option>
        <option name="charting.drilldown">none</option>
        <option name="refresh.display">progressbar</option>
      </chart>
    </panel>
  </row>
</form>