{
    "pages": {
        "configuration": {
            "description": "Set up your add-on",
            "title": "Configuration",
            "tabs": [
                {
                    "name": "parameters",
                    "title": "GreyNoise Setup",
                    "entity": [
                        {
                            "encrypted": true,
                            "required": true,
                            "type": "text",
                            "label": "API Key",
                            "field": "api_key",
                            "defaultValue": "",
                            "validators": [
                                {
                                    "maxLength": 8192,
                                    "minLength": 1,
                                    "errorMsg": "The length of the API Key should be between 1 and 8192",
                                    "type": "string"
                                }
                            ],
                            "help": "Enter the API key of GreyNoise."
                        }
                    ]
                },
                {
                    "entity": [
                        {
                            "required": true,
                            "type": "multipleSelect",
                            "label": "Indexes",
                            "field": "ip_indexes",
                            "defaultValue": "main",
                            "options": {
                                "denyList": "^_.*$",
                                "delimiter": ",",
                                "endpointUrl": "data/indexes"
                            },
                            "help": "Select the indexes to be scanned in the deployment."
                        },
                        {
                            "required": true,
                            "type": "multipleSelect",
                            "label": "CIM Fields",
                            "field": "cim_ip_fields",
                            "defaultValue": "all",
                            "options": {
                                "delimiter": ",",
                                "items": [
                                    {
                                        "value": "all",
                                        "label": "All"
                                    },
                                    {
                                        "value": "dest",
                                        "label": "dest"
                                    },
                                    {
                                        "value": "dvc",
                                        "label": "dvc"
                                    },
                                    {
                                        "value": "src",
                                        "label": "src"
                                    },
                                    {
                                        "value": "dest_ip",
                                        "label": "dest_ip"
                                    },
                                    {
                                        "value": "src_ip",
                                        "label": "src_ip"
                                    },
                                    {
                                        "value": "dvc_ip",
                                        "label": "dvc_ip"
                                    },
                                    {
                                        "value": "orig_src",
                                        "label": "orig_src"
                                    },
                                    {
                                        "value": "orig_dest",
                                        "label": "orig_dest"
                                    },
                                    {
                                        "value": "host",
                                        "label": "host"
                                    },
                                    {
                                        "value": "source",
                                        "label": "source"
                                    },
                                    {
                                        "value": "dest_translated_ip",
                                        "label": "dest_translated_ip"
                                    },
                                    {
                                        "value": "src_translated_ip",
                                        "label": "src_translated_ip"
                                    }
                                ]
                            },
                            "help": "Select the CIM fields containing IP address to scan for internet scanner status."
                        },
                        {
                            "required": false,
                            "type": "text",
                            "label": "Other Fields",
                            "field": "other_ip_fields",
                            "defaultValue": "",
                            "help": "Enter other comma(,) separated fields containing IP address to scan for internet scanner status. Example: ip_field1,ip_field2",
                            "validators": [
                                {
                                    "maxLength": 8192,
                                    "minLength": 1,
                                    "errorMsg": "The length of the fields should be atleast 1",
                                    "type": "string"
                                }
                            ]
                        },
                        {
                            "required": true,
                            "type": "singleSelect",
                            "label": "Scan Start Time",
                            "field": "scan_start_time",
                            "defaultValue": "LAST_SEVEN_DAYS",
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Now",
                                        "value": "NOW"
                                    },
                                    {
                                        "label": "Last 5 minutes",
                                        "value": "LAST_FIVE_MINS"
                                    },
                                    {
                                        "label": "Last 60 minutes",
                                        "value": "LAST_SIXTY_MINS"
                                    },
                                    {
                                        "label": "Last 24 hours",
                                        "value": "LAST_TWENTY_FOUR_HOURS"
                                    },
                                    {
                                        "label": "Last 7 days",
                                        "value": "LAST_SEVEN_DAYS"
                                    },
                                    {
                                        "label": "Last 30 days",
                                        "value": "LAST_THIRTY_DAYS"
                                    },
                                    {
                                        "label": "Last 60 days",
                                        "value": "LAST_SIXTY_DAYS"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Specify the time range for scanning the indexed Splunk data."
                        },
                        {
                            "field": "enable_ss",
                            "label": "Enable Scan Deployment",
                            "type": "checkbox",
                            "help": "Select this checkbox to enable scanning of the deployment.",
                            "required": false
                        },
                        {
                            "field": "force_enable_ss",
                            "label": "Force Scan Deployment",
                            "type": "checkbox",
                            "help": "Select this checkbox to stop the current scan and forcefully initialize a new scan.",
                            "required": false
                        },
                        {
                            "field": "update_risk_score_to_splunk_es",
                            "type": "checkbox",
                            "label": "Update Risk Score To Splunk ES",
                            "defaultValue": 0,
                            "required": false,
                            "help": "Select this checkbox to update the risk score to Splunk ES risk index."
                        },
                        {
                            "field": "malicious_score",
                            "type": "text",
                            "label": "Malicious",
                            "defaultValue": "80",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        0,
                                        100
                                    ],
                                    "errorMsg": "Score must be a number [0-100]"
                                },
                                {
                                    "pattern": "^\\d{1,3}$",
                                    "errorMsg": "Score should be a valid integer only",
                                    "type": "regex"
                                }
                            ],
                            "help": "Enter the risk score threshold for Malicious classification"
                        },
                        {
                            "field": "suspicious_score",
                            "type": "text",
                            "label": "Suspicious",
                            "defaultValue": "50",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        0,
                                        100
                                    ],
                                    "errorMsg": "Score must be a number [0-100]"
                                },
                                {
                                    "pattern": "^\\d{1,3}$",
                                    "errorMsg": "Score should be a valid integer only",
                                    "type": "regex"
                                }
                            ],
                            "help": "Enter the risk score threshold for Suspicious classification"
                        },
                        {
                            "field": "unknown_score",
                            "type": "text",
                            "label": "Unknown",
                            "defaultValue": "30",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        0,
                                        100
                                    ],
                                    "errorMsg": "Score must be a number [0-100]"
                                },
                                {
                                    "pattern": "^\\d{1,3}$",
                                    "errorMsg": "Score should be a valid integer only",
                                    "type": "regex"
                                }
                            ],
                            "help": "Enter the risk score threshold for Unknown classification"
                        },
                        {
                            "field": "benign_score",
                            "type": "text",
                            "label": "Benign",
                            "defaultValue": "10",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        0,
                                        100
                                    ],
                                    "errorMsg": "Score must be a number [0-100]"
                                },
                                {
                                    "pattern": "^\\d{1,3}$",
                                    "errorMsg": "Score should be a valid integer only",
                                    "type": "regex"
                                }
                            ],
                            "help": "Enter the risk score threshold for Benign classification"
                        }
                    ],
                    "hook": {
                        "type": "external",
                        "src": "ScanDeploymentHook"
                    },
                    "title": "Scan Deployment",
                    "name": "scan_deployment"
                },
                {
                    "entity": [
                        {
                            "field": "enable_feed_import",
                            "type": "checkbox",
                            "label": "Enable Feed Import",
                            "defaultValue": 0,
                            "required": false,
                            "help": "Select this checkbox to enable the ingest of a GreyNoise Feed. IMPORTANT: Ensure your subscription includes an appropriate license."
                        },
                        {
                            "field": "force_enable_ss",
                            "label": "Force Feed Run Now",
                            "type": "checkbox",
                            "help": "Select this checkbox to immediately begin a feed ingest based on the selected options.",
                            "required": false
                        },
                        {
                            "required": true,
                            "type": "singleSelect",
                            "label": "Feed Selection",
                            "field": "feed_selection",
                            "defaultValue": "BENIGN",
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Benign Indicators - Last 24 Hours",
                                        "value": "BENIGN"
                                    },
                                    {
                                        "label": "Malicious Indicators - Last 24 Hours",
                                        "value": "MALICIOUS"
                                    },
                                    {
                                        "label": "Suspicious Indicators - Last 24 Hours",
                                        "value": "SUSPICIOUS"
                                    },
                                    {
                                        "label": "Malicious and Benign Indicators - Last 24 Hours",
                                        "value": "MALICIOUS_BENIGN"
                                    },
                                    {
                                        "label": "Malicious, Suspicious, and Benign Indicators - Last 24 Hours",
                                        "value": "MALICIOUS_SUSPICIOUS_BENIGN"
                                    },
                                    {
                                        "label": "All Indicators - Last 24 Hours",
                                        "value": "ALL"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Select which GreyNoise feed type to ingest."
                        },
                        {
                            "field": "include_community_dataset",
                            "type": "checkbox",
                            "label": "Include Community Dataset",
                            "defaultValue": 0,
                            "required": true,
                            "help": "Select this checkbox to include community dataset results in the feed query."
                        },
                        {
                            "field": "ingest_feed_to_index",
                            "type": "checkbox",
                            "label": "Ingest Feed To Index",
                            "defaultValue": 0,
                            "required": false,
                            "help": "Selecting this checkbox will ingest data into the Splunk index. Please check your licensing as this feature will consume license capacity. Enable this option only if you need to map feed data to Splunk CIM data models for specific use cases."
                        },
                        {
                            "required": true,
                            "type": "singleSelect",
                            "label": "Index",
                            "field": "feed_index",
                            "defaultValue": "main",
                            "options": {
                                "denyList": "^_.*$",
                                "endpointUrl": "data/indexes"
                            },
                            "help": "Select the index to add feed."
                        }
                    ],
                    "hook": {
                        "type": "external",
                        "src": "FeedConfigurationHook"
                    },
                    "title": "Feed Configuration",
                    "name": "feed_configuration"
                },
                {
                    "entity": [
                        {
                            "field": "enable_callback_feed",
                            "type": "checkbox",
                            "label": "Enable Callback IP Feed",
                            "defaultValue": 0,
                            "required": false,
                            "help": "Select this checkbox to enable scheduled ingest of GreyNoise Callback IPs into the greynoise_callback_indicators store. Requires a Callback-enabled GreyNoise license."
                        },
                        {
                            "field": "force_enable_callback_feed",
                            "label": "Force Callback Feed Run Now",
                            "type": "checkbox",
                            "help": "Select this checkbox to immediately begin a Callback feed ingest using the selected filter options.",
                            "required": false
                        },
                        {
                            "field": "is_stage_1",
                            "type": "singleSelect",
                            "label": "Stage 1 (File Downloaded)",
                            "defaultValue": "any",
                            "required": false,
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Any",
                                        "value": "any"
                                    },
                                    {
                                        "label": "Yes",
                                        "value": "true"
                                    },
                                    {
                                        "label": "No",
                                        "value": "false"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Filter to IPs where a file was downloaded (stage 1), or leave as Any."
                        },
                        {
                            "field": "is_stage_2",
                            "type": "singleSelect",
                            "label": "Stage 2 (Suspected C2)",
                            "defaultValue": "any",
                            "required": false,
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Any",
                                        "value": "any"
                                    },
                                    {
                                        "label": "Yes",
                                        "value": "true"
                                    },
                                    {
                                        "label": "No",
                                        "value": "false"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Filter to IPs suspected as C2 from VT/sandbox analysis (stage 2), or leave as Any."
                        },
                        {
                            "field": "has_files",
                            "type": "singleSelect",
                            "label": "Has Files",
                            "defaultValue": "any",
                            "required": false,
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Any",
                                        "value": "any"
                                    },
                                    {
                                        "label": "Yes",
                                        "value": "true"
                                    },
                                    {
                                        "label": "No",
                                        "value": "false"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Filter to IPs that have malware files associated, only without files, or Any."
                        },
                        {
                            "field": "first_seen_after",
                            "type": "singleSelect",
                            "label": "First Seen After",
                            "defaultValue": "any",
                            "required": false,
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Any",
                                        "value": "any"
                                    },
                                    {
                                        "label": "1 day ago",
                                        "value": "1"
                                    },
                                    {
                                        "label": "7 days ago",
                                        "value": "7"
                                    },
                                    {
                                        "label": "14 days ago",
                                        "value": "14"
                                    },
                                    {
                                        "label": "30 days ago",
                                        "value": "30"
                                    },
                                    {
                                        "label": "45 days ago",
                                        "value": "45"
                                    },
                                    {
                                        "label": "60 days ago",
                                        "value": "60"
                                    },
                                    {
                                        "label": "90 days ago",
                                        "value": "90"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Only IPs first seen after this relative date (today minus the selected number of days). Leave as Any for no filter."
                        },
                        {
                            "field": "first_seen_before",
                            "type": "singleSelect",
                            "label": "First Seen Before",
                            "defaultValue": "any",
                            "required": false,
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Any",
                                        "value": "any"
                                    },
                                    {
                                        "label": "1 day ago",
                                        "value": "1"
                                    },
                                    {
                                        "label": "7 days ago",
                                        "value": "7"
                                    },
                                    {
                                        "label": "14 days ago",
                                        "value": "14"
                                    },
                                    {
                                        "label": "30 days ago",
                                        "value": "30"
                                    },
                                    {
                                        "label": "45 days ago",
                                        "value": "45"
                                    },
                                    {
                                        "label": "60 days ago",
                                        "value": "60"
                                    },
                                    {
                                        "label": "90 days ago",
                                        "value": "90"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Only IPs first seen before this relative date (today minus the selected number of days). Leave as Any for no filter."
                        },
                        {
                            "field": "last_seen_after",
                            "type": "singleSelect",
                            "label": "Last Seen After",
                            "defaultValue": "any",
                            "required": false,
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Any",
                                        "value": "any"
                                    },
                                    {
                                        "label": "1 day ago",
                                        "value": "1"
                                    },
                                    {
                                        "label": "7 days ago",
                                        "value": "7"
                                    },
                                    {
                                        "label": "14 days ago",
                                        "value": "14"
                                    },
                                    {
                                        "label": "30 days ago",
                                        "value": "30"
                                    },
                                    {
                                        "label": "45 days ago",
                                        "value": "45"
                                    },
                                    {
                                        "label": "60 days ago",
                                        "value": "60"
                                    },
                                    {
                                        "label": "90 days ago",
                                        "value": "90"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Only IPs last seen after this relative date (today minus the selected number of days). Leave as Any for no filter."
                        },
                        {
                            "field": "last_seen_before",
                            "type": "singleSelect",
                            "label": "Last Seen Before",
                            "defaultValue": "any",
                            "required": false,
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "Any",
                                        "value": "any"
                                    },
                                    {
                                        "label": "1 day ago",
                                        "value": "1"
                                    },
                                    {
                                        "label": "7 days ago",
                                        "value": "7"
                                    },
                                    {
                                        "label": "14 days ago",
                                        "value": "14"
                                    },
                                    {
                                        "label": "30 days ago",
                                        "value": "30"
                                    },
                                    {
                                        "label": "45 days ago",
                                        "value": "45"
                                    },
                                    {
                                        "label": "60 days ago",
                                        "value": "60"
                                    },
                                    {
                                        "label": "90 days ago",
                                        "value": "90"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "help": "Only IPs last seen before this relative date (today minus the selected number of days). Leave as Any for no filter."
                        },
                        {
                            "field": "file_type",
                            "type": "text",
                            "label": "File Type",
                            "defaultValue": "",
                            "required": false,
                            "help": "Filter by MIME type (for example application/x-executable). Leave blank for no filter.",
                            "validators": [
                                {
                                    "maxLength": 256,
                                    "minLength": 0,
                                    "errorMsg": "File type must be 256 characters or less",
                                    "type": "string"
                                }
                            ]
                        },
                        {
                            "field": "file_name",
                            "type": "text",
                            "label": "File Name",
                            "defaultValue": "",
                            "required": false,
                            "help": "Filter by file name substring. Leave blank for no filter.",
                            "validators": [
                                {
                                    "maxLength": 512,
                                    "minLength": 0,
                                    "errorMsg": "File name must be 512 characters or less",
                                    "type": "string"
                                }
                            ]
                        },
                        {
                            "field": "file_hash",
                            "type": "text",
                            "label": "File Hash (SHA256)",
                            "defaultValue": "",
                            "required": false,
                            "help": "Filter by file SHA256 hash. Leave blank for no filter.",
                            "validators": [
                                {
                                    "maxLength": 128,
                                    "minLength": 0,
                                    "errorMsg": "File hash must be 128 characters or less",
                                    "type": "string"
                                }
                            ]
                        },
                        {
                            "field": "scanner_ips",
                            "type": "text",
                            "label": "Scanner IPs",
                            "defaultValue": "",
                            "required": false,
                            "help": "Optional comma-separated scanner IPs used to filter Callback results. Leave blank for no filter.",
                            "validators": [
                                {
                                    "maxLength": 8192,
                                    "minLength": 0,
                                    "errorMsg": "Scanner IPs list must be 8192 characters or less",
                                    "type": "string"
                                }
                            ]
                        },
                        {
                            "field": "ips",
                            "type": "text",
                            "label": "Callback IPs",
                            "defaultValue": "",
                            "required": false,
                            "help": "Optional comma-separated Callback IPs to restrict the feed to a specific set. Leave blank to ingest all matching Callback IPs.",
                            "validators": [
                                {
                                    "maxLength": 8192,
                                    "minLength": 0,
                                    "errorMsg": "Callback IPs list must be 8192 characters or less",
                                    "type": "string"
                                }
                            ]
                        }
                    ],
                    "title": "Callback IP Feed",
                    "name": "callback_feed_configuration"
                },
                {
                    "entity": [
                        {
                            "field": "enable_caching",
                            "type": "checkbox",
                            "label": "Enable Caching",
                            "defaultValue": 1,
                            "required": false,
                            "help": "Select this checkbox to enable caching for all custom commands."
                        },
                        {
                            "field": "ttl",
                            "label": "Time to live",
                            "type": "text",
                            "required": false,
                            "defaultValue": "24",
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        1,
                                        72
                                    ],
                                    "errorMsg": "Time to live should be in a range of 1 to 72"
                                },
                                {
                                    "pattern": "^\\d{1,2}$",
                                    "errorMsg": "Time to live should be a valid integer only",
                                    "type": "regex"
                                }
                            ],
                            "help": "Enter a positive integer in the range 1-72 representing the caches' Time to live (in hours)."
                        },
                        {
                            "field": "purge_cache",
                            "label": "Purge Cache",
                            "type": "checkbox",
                            "required": false,
                            "help": "Check this option to the purge the cache. After clicking the save button, the cache will be cleared."
                        }
                    ],
                    "title": "Caching",
                    "name": "caching"
                },
                {
                    "entity": [
                        {
                            "type": "singleSelect",
                            "label": "Log level",
                            "field": "loglevel",
                            "defaultValue": "INFO",
                            "options": {
                                "autoCompleteFields": [
                                    {
                                        "label": "DEBUG",
                                        "value": "DEBUG"
                                    },
                                    {
                                        "label": "INFO",
                                        "value": "INFO"
                                    },
                                    {
                                        "label": "WARNING",
                                        "value": "WARNING"
                                    },
                                    {
                                        "label": "ERROR",
                                        "value": "ERROR"
                                    },
                                    {
                                        "label": "CRITICAL",
                                        "value": "CRITICAL"
                                    }
                                ],
                                "disableSearch": true
                            },
                            "required": true
                        }
                    ],
                    "title": "Logging",
                    "name": "logging"
                }
            ]
        }
    },
    "meta": {
        "displayName": "GreyNoise App for Splunk",
        "version": "3.1.0",
        "restRoot": "app_greynoise",
        "name": "SA-GreyNoise",
        "apiVersion": "3.0.0",
        "schemaVersion": "0.0.10",
        "_uccVersion": "6.6.0"
    }
}
