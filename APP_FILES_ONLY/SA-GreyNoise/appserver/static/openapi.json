                        "type": "string"
                    },
                    "cim_ip_fields": {
                        "type": "string"
                    },
                    "other_ip_fields": {
                        "type": "string"
                    },
                    "scan_start_time": {
                        "type": "string",
                        "enum": [
                            "NOW",
                            "LAST_FIVE_MINS",
                            "LAST_SIXTY_MINS",
                            "LAST_TWENTY_FOUR_HOURS",
                            "LAST_SEVEN_DAYS",
